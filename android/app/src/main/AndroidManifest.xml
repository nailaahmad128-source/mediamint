<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        MediaMint reads media the user explicitly picks via the system file
        picker (Storage Access Framework), which needs no permission. The
        permissions below are only for the Recent Files / Home screen
        experience and are the narrowest ones Android offers for each OS
        version — no broad MANAGE_EXTERNAL_STORAGE, no legacy full storage
        access on modern Android.
    -->

    <!-- Android 13+ (API 33+): granular media read permissions. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Android 6-12 (API 23-32): legacy scoped storage read. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
        Only needed pre-Android 10 (API 29) to write outside the app's own
        directory (e.g. the optional Downloads save location). On API 29+
        this is unused because scoped storage handles app-created files
        without it; requestLegacyExternalStorage is deliberately NOT set,
        keeping the app on modern scoped storage everywhere it can be.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="MediaMint"
        android:name="${applicationName}"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Required so file_picker / share_plus / open_filex can hand our
             app-private output files to other apps via a content:// Uri
             instead of a raw file path (required on modern Android). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

    <!-- Declares the system file picker as queryable, required on Android 11+
         (API 30+) package visibility rules for ACTION_OPEN_DOCUMENT to work. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT"/>
            <data android:mimeType="*/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
    </queries>
</manifest>
